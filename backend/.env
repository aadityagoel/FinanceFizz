# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017/financial_vault

# JWT Configuration
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption Key for sensitive data (32 bytes base64)
ENCRYPTION_KEY=your-encryption-key-change-this-32-bytes-minimum-secret

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# AI Configuration (Optional - for smart recommendations)
AI_ENABLED=false
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=openai